        "query": "SELECT\n    sd.texto_fundamental AS titulo,\n    sd.status,\n    sd.trello_card_id\nFROM\n    solicitacoes_design sd\nJOIN\n    clientes c ON sd.cliente_id = c.id\nWHERE\n    c.numero_cliente = '{{ $json.numero }}'\n\nUNION ALL\n\nSELECT\n    sv.titulo_video AS titulo,\n    sv.status,\n    sv.trello_card_id\nFROM\n    solicitacoes_video sv\nJOIN\n    clientes c ON sv.cliente_id = c.id\nWHERE\n    c.numero_cliente = '{{ $json.numero }}'\n\n-- Opcional: Você pode adicionar um ORDER BY aqui se quiser ordenar os resultados combinados\n-- ORDER BY titulo ASC",
